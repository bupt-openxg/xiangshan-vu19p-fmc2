# Frozen EQ4 builds use the exact signed-off software profile. Candidate
# switches are disabled in this maintained export and cannot alter the build.
MIMO_EQ4_PROFILE_MANIFEST_eq_zf_4x4_scalar := $(CURDIR)/config/profiles/eq_zf_4x4-scalar.mk
MIMO_EQ4_PROFILE_MANIFEST_eq_zf_4x4_rvv := $(CURDIR)/config/profiles/eq_zf_4x4-rvv.mk
MIMO_EQ4_PROFILE_MANIFEST_eq_zf_4x4_ext := $(CURDIR)/config/profiles/eq_zf_4x4-ext.mk
MIMO_EQ4_PROFILE_MANIFEST_eq_mmse_4x4_scalar := $(CURDIR)/config/profiles/eq_mmse_4x4-scalar.mk
MIMO_EQ4_PROFILE_MANIFEST_eq_mmse_4x4_rvv := $(CURDIR)/config/profiles/eq_mmse_4x4-rvv.mk
MIMO_EQ4_PROFILE_MANIFEST_eq_mmse_4x4_ext := $(CURDIR)/config/profiles/eq_mmse_4x4-ext.mk

ifneq ($(filter $(MIMO_ACTIVE_KERNEL),eq_zf_4x4 eq_mmse_4x4),)
ifneq ($(MIMO_EQ4_FROZEN_LOCK),1)
$(error EQ4 kernels are frozen; MIMO_EQ4_FROZEN_LOCK must remain 1)
endif
MIMO_EQ4_PROFILE_MANIFEST := $(MIMO_EQ4_PROFILE_MANIFEST_$(MIMO_ACTIVE_KERNEL)_$(MIMO_IMPL))
ifeq ($(wildcard $(MIMO_EQ4_PROFILE_MANIFEST)),)
$(error Missing frozen profile for $(MIMO_ACTIVE_KERNEL)/$(MIMO_IMPL): $(MIMO_EQ4_PROFILE_MANIFEST))
endif
MIMO_EQ4_PROFILE_ASSIGNMENTS := $(shell awk -F= '/^MIMO_/ { printf "%s=%s ", $$1, $$2 }' $(MIMO_EQ4_PROFILE_MANIFEST))
MIMO_EQ4_PROFILE_VARS := $(foreach assignment,$(MIMO_EQ4_PROFILE_ASSIGNMENTS),$(word 1,$(subst =, ,$(assignment))))
MIMO_EQ4_OPTION_VARS := $(sort $(filter MIMO_USE_% MIMO_CHECK_% MIMO_DEBUG_% MIMO_COLLECT_% MIMO_SOLVE4_% MIMO_EQ4_% MIMO_EXT_%,$(.VARIABLES)))
MIMO_EQ4_OPTION_VARS := $(filter-out MIMO_USE_EQ2_% MIMO_USE_SCALAR_EQ2_% MIMO_USE_RVV_EQ2_% MIMO_USE_EXT_EQ2_% MIMO_EQ2_% MIMO_EQ4_FROZEN_LOCK MIMO_EQ4_PROFILE_% MIMO_EQ4_OPTION_VARS,$(MIMO_EQ4_OPTION_VARS))
$(foreach option,$(MIMO_EQ4_OPTION_VARS),$(eval override $(option) := 0))
$(foreach assignment,$(MIMO_EQ4_PROFILE_ASSIGNMENTS),$(eval override $(assignment)))
override MIMO_EQ4_FROZEN_PROFILE := $(MIMO_ACTIVE_KERNEL)/$(MIMO_IMPL)
else
override MIMO_EQ4_FROZEN_PROFILE := none
endif

# Frozen EQ2 builds use one accepted software profile per kernel/backend.
# Candidate switches are disabled in this maintained export and cannot alter
# the mainline build.
MIMO_EQ2_PROFILE_MANIFEST_eq_zf_2x2_scalar := $(CURDIR)/config/profiles/eq_zf_2x2-scalar.mk
MIMO_EQ2_PROFILE_MANIFEST_eq_zf_2x2_rvv := $(CURDIR)/config/profiles/eq_zf_2x2-rvv.mk
