.PHONY: mimo-print-mainline-profile
mimo-print-mainline-profile:
	@printf 'MIMO_EQ4_FROZEN_PROFILE=%s\n' '$(MIMO_EQ4_FROZEN_PROFILE)'
	@$(foreach name,$(sort $(MIMO_EQ4_PROFILE_VARS)),printf '%s=%s\n' '$(name)' '$($(name))';)
	@printf 'MIMO_EQ2_FROZEN_PROFILE=%s\n' '$(MIMO_EQ2_FROZEN_PROFILE)'
	@printf 'MIMO_EQ2_EXPERIMENTAL_PROFILE=%s\n' '$(MIMO_EQ2_EXPERIMENTAL_PROFILE)'
	@$(foreach name,$(sort $(MIMO_EQ2_PROFILE_VARS)),printf '%s=%s\n' '$(name)' '$($(name))';)
	@printf 'MIMO_USE_RVV_EQ2_UQ12_SCALE=%s\n' '$(MIMO_USE_RVV_EQ2_UQ12_SCALE)'
	@printf 'MIMO_USE_RVV_EQ2_EARLY_RECIP_OVERLAP=%s\n' '$(MIMO_USE_RVV_EQ2_EARLY_RECIP_OVERLAP)'
	@printf 'MIMO_USE_RVV_EQ2_MMSE_FULL_TRUNC_SCALE=%s\n' '$(MIMO_USE_RVV_EQ2_MMSE_FULL_TRUNC_SCALE)'
	@printf 'MIMO_USE_EQ2_ZF_GUARD1_FINE_RECIP=%s\n' '$(MIMO_USE_EQ2_ZF_GUARD1_FINE_RECIP)'
	@printf 'MIMO_USE_EXT_EQ2_ZF_GUARD1_HYBRID=%s\n' '$(MIMO_USE_EXT_EQ2_ZF_GUARD1_HYBRID)'
	@printf 'MIMO_USE_EXT_EQ2_MMSE_ADAPTIVE_Q13=%s\n' '$(MIMO_USE_EXT_EQ2_MMSE_ADAPTIVE_Q13)'
	@printf 'MIMO_USE_SCALAR_EQ2_MMSE_FULL_TRUNC_SCALE=%s\n' '$(MIMO_USE_SCALAR_EQ2_MMSE_FULL_TRUNC_SCALE)'

