MIMO_EQ2_PROFILE_MANIFEST_eq_mmse_2x2_scalar := $(CURDIR)/config/profiles/eq_mmse_2x2-scalar.mk
MIMO_EQ2_PROFILE_MANIFEST_eq_mmse_2x2_rvv := $(CURDIR)/config/profiles/eq_mmse_2x2-rvv.mk
MIMO_EQ2_PROFILE_MANIFEST_eq_mmse_2x2_ext := $(CURDIR)/config/profiles/eq_mmse_2x2-ext.mk
MIMO_EQ2_REOPENED_COMBINATIONS := eq_zf_2x2/rvv eq_mmse_2x2/scalar eq_mmse_2x2/rvv eq_mmse_2x2/ext

ifneq ($(filter $(MIMO_ACTIVE_KERNEL),eq_zf_2x2 eq_mmse_2x2),)
ifneq ($(MIMO_EQ2_FROZEN_LOCK),1)
$(error EQ2 kernels are frozen; MIMO_EQ2_FROZEN_LOCK must remain 1)
endif
ifneq ($(filter $(MIMO_EQ2_EXPERIMENTAL_PROFILE),0 1),$(MIMO_EQ2_EXPERIMENTAL_PROFILE))
$(error MIMO_EQ2_EXPERIMENTAL_PROFILE must be 0 or 1)
endif
MIMO_EQ2_PROFILE_MANIFEST := $(MIMO_EQ2_PROFILE_MANIFEST_$(MIMO_ACTIVE_KERNEL)_$(MIMO_IMPL))
ifeq ($(wildcard $(MIMO_EQ2_PROFILE_MANIFEST)),)
$(error Missing frozen profile for $(MIMO_ACTIVE_KERNEL)/$(MIMO_IMPL): $(MIMO_EQ2_PROFILE_MANIFEST))
endif
MIMO_EQ2_PROFILE_ASSIGNMENTS := $(shell awk -F= '/^MIMO_/ { printf "%s=%s ", $$1, $$2 }' $(MIMO_EQ2_PROFILE_MANIFEST))
MIMO_EQ2_PROFILE_VARS := $(foreach assignment,$(MIMO_EQ2_PROFILE_ASSIGNMENTS),$(word 1,$(subst =, ,$(assignment))))
MIMO_EQ2_OPTION_VARS := $(sort $(filter MIMO_EQ2_% MIMO_USE_EQ2_% MIMO_USE_SCALAR_EQ2_% MIMO_USE_RVV_EQ2_% MIMO_USE_EXT_EQ2_%,$(.VARIABLES)))
MIMO_EQ2_OPTION_VARS := $(filter-out MIMO_EQ2_QUALITY_% MIMO_EQ2_FROZEN_LOCK MIMO_EQ2_EXPERIMENTAL_PROFILE MIMO_EQ2_PROFILE_% MIMO_EQ2_OPTION_VARS,$(MIMO_EQ2_OPTION_VARS))
MIMO_EQ2_OPTION_VARS += MIMO_USE_SOLVE_STORE_TRUST_I16
ifeq ($(MIMO_EQ2_EXPERIMENTAL_PROFILE),1)
ifeq ($(filter $(MIMO_ACTIVE_KERNEL)/$(MIMO_IMPL),$(MIMO_EQ2_REOPENED_COMBINATIONS)),)
$(error Experimental EQ2 profile is forbidden for frozen kernel $(MIMO_ACTIVE_KERNEL)/$(MIMO_IMPL))
endif
$(foreach option,$(MIMO_EQ2_OPTION_VARS),$(eval $(option) := 0))
$(foreach assignment,$(MIMO_EQ2_PROFILE_ASSIGNMENTS),$(eval $(assignment)))
override MIMO_EQ2_FROZEN_PROFILE := experimental/$(MIMO_ACTIVE_KERNEL)/$(MIMO_IMPL)
else
$(foreach option,$(MIMO_EQ2_OPTION_VARS),$(eval override $(option) := 0))
$(foreach assignment,$(MIMO_EQ2_PROFILE_ASSIGNMENTS),$(eval override $(assignment)))
override MIMO_EQ2_FROZEN_PROFILE := $(MIMO_ACTIVE_KERNEL)/$(MIMO_IMPL)
endif
else
override MIMO_EQ2_FROZEN_PROFILE := none
endif

