MIMO_FROZEN_KERNELS := eq_zf_2x2 eq_mmse_2x2 eq_zf_4x4 eq_mmse_4x4
MIMO_FROZEN_IMPLS := scalar rvv ext

.PHONY: xvbbp-build-all
xvbbp-build-all:
	@set -eu; \
	for impl in $(MIMO_FROZEN_IMPLS); do \
	  for kernel in $(MIMO_FROZEN_KERNELS); do \
	    $(MAKE) MIMO_IMPL=$$impl MIMO_VALIDATE_KERNEL=$$kernel MIMO_PERF=0; \
	  done; \
	done
