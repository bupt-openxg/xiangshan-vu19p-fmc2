endif
ifneq ($(origin MIMO_USE_SITE4_8X8_BUILD),undefined)
$(error 8x8 has been removed from the current execution scope; do not set MIMO_USE_SITE4_8X8_BUILD)
endif
ifneq ($(origin MIMO_ALLOW_2X2),undefined)
$(error MIMO_ALLOW_2X2 is an obsolete scope knob; select eq_zf_2x2 or eq_mmse_2x2 directly)
endif
ifneq ($(origin MIMO_USE_SITE2_2X2_BUILD),undefined)
$(error MIMO_USE_SITE2_2X2_BUILD is obsolete; EQ2 backends use explicit native layouts)
endif

ifneq ($(filter $(MIMO_VALIDATE_KERNEL),eq_zf_2x2 eq_mmse_2x2 eq_zf_4x4 eq_mmse_4x4),$(MIMO_VALIDATE_KERNEL))
$(error Current hard scope permits only 2x2/4x4 ZF/MMSE validation)
endif
ifneq ($(filter $(MIMO_PERF_KERNEL),eq_zf_2x2 eq_mmse_2x2 eq_zf_4x4 eq_mmse_4x4),$(MIMO_PERF_KERNEL))
$(error Current hard scope permits only 2x2/4x4 ZF/MMSE perf)
endif
ifneq ($(MIMO_USE_SOLVE4_SCHUR_ZF_VSOLVE2H2_ASM),0)
$(error MIMO_USE_SOLVE4_SCHUR_ZF_VSOLVE2H2_ASM is disabled on the fixed hardware platform; do not build or submit the vsolve2h2 accident-line path)
endif

