# Explicit frozen-kernel map for the final integration candidate.
# Each point/backend has exactly one source file and one recorded flag set.

ifeq ($(DFT_IMPL),dft_scalar)
ifeq ($(FFT_POINTS),16)
FFT_KERNEL_SOURCE := ./kernels/scalar/n16/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0
else ifeq ($(FFT_POINTS),64)
FFT_KERNEL_SOURCE := ./kernels/scalar/n64/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_SCALAR_PRELAYOUT_N64=1
else ifeq ($(FFT_POINTS),128)
FFT_KERNEL_SOURCE := ./kernels/scalar/n128/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_SCALAR_PRELAYOUT_N128=1
else ifeq ($(FFT_POINTS),256)
FFT_KERNEL_SOURCE := ./kernels/scalar/n256/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_SCALAR_PRELAYOUT_N256=1
else ifeq ($(FFT_POINTS),512)
FFT_KERNEL_SOURCE := ./kernels/scalar/n512/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_SCALAR_PRELAYOUT_N512=1
else ifeq ($(FFT_POINTS),1024)
FFT_KERNEL_SOURCE := ./kernels/scalar/n1024/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_SCALAR_PRELAYOUT_N1024=1
else ifeq ($(FFT_POINTS),2048)
FFT_KERNEL_SOURCE := ./kernels/scalar/n2048/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_SCALAR_PRELAYOUT_N2048=1
else ifeq ($(FFT_POINTS),4096)
FFT_KERNEL_SOURCE := ./kernels/scalar/n4096/dft_scalar.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_SCALAR_PRELAYOUT_N4096=1
endif
else ifeq ($(DFT_IMPL),dft_rvv)
ifeq ($(FFT_POINTS),16)
FFT_KERNEL_SOURCE := ./kernels/rvv/n16/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0
else ifeq ($(FFT_POINTS),64)
FFT_KERNEL_SOURCE := ./kernels/rvv/n64/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_PRELAYOUT_N64=1
else ifeq ($(FFT_POINTS),128)
FFT_KERNEL_SOURCE := ./kernels/rvv/n128/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_PRELAYOUT_N128=1
else ifeq ($(FFT_POINTS),256)
FFT_KERNEL_SOURCE := ./kernels/rvv/n256/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_PRELAYOUT_N256=1 -DFFT_RVV_PARTIAL_LEAF_RESIDENT_N256=1 -DFFT_RVV_LMUL2_RADIX4_N256=1
else ifeq ($(FFT_POINTS),512)
FFT_KERNEL_SOURCE := ./kernels/rvv/n512/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_PRELAYOUT_N512=1 -DFFT_RVV_LMUL2_RADIX4_N256_SCALE1_N512=1 -DFFT_RVV_LMUL2_RADIX2_N512=1
else ifeq ($(FFT_POINTS),1024)
FFT_KERNEL_SOURCE := ./kernels/rvv/n1024/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_PRELAYOUT_N1024=1 -DFFT_RVV_LMUL2_RADIX4_N1024=1 -DFFT_RVV_LMUL2_RADIX4_N256_SCALE1_N1024=1
else ifeq ($(FFT_POINTS),2048)
FFT_KERNEL_SOURCE := ./kernels/rvv/n2048/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_PRELAYOUT_N2048=1 -DFFT_RVV_LMUL2_RADIX4_N1024=0 -DFFT_RVV_LMUL2_RADIX4_N1024_SCALE1_N2048=1 -DFFT_RVV_LMUL2_RADIX4_N256_SCALE1_N2048=1
else ifeq ($(FFT_POINTS),4096)
FFT_KERNEL_SOURCE := ./kernels/rvv/n4096/dft_rvv.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=0 -DFFT_PRELAYOUT_N4096=1 -DFFT_RVV_LMUL2_RADIX4_N4096=1 -DFFT_RVV_LMUL2_RADIX4_N1024=0 -DFFT_RVV_LMUL2_RADIX4_N1024_SCALE1_N4096=1 -DFFT_RVV_LMUL2_RADIX4_N256_SCALE1_N4096=1
endif
else ifeq ($(DFT_IMPL),dft_ext)
ifeq ($(FFT_POINTS),16)
FFT_KERNEL_SOURCE := ./kernels/ext/n16/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1
else ifeq ($(FFT_POINTS),64)
FFT_KERNEL_SOURCE := ./kernels/ext/n64/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1 -DFFT_CUSTOM_ROTATE_ADD_HELPERS=0 -DFFT_PRELAYOUT_N64=1 -DFFT_EXT_FUSED_LEAF_COMBINE_N64=1 -DFFT_EXT_LEAF_TWIDDLE_RESIDENT=1 -DFFT_EXT_FULL_LEAF_RESIDENT=1 -DFFT_EXT_INDIVIDUAL_ROTATE_DFT16=1 -DFFT_EXT_ROTATE_BOUNDARY_FALLBACK=1
else ifeq ($(FFT_POINTS),128)
FFT_KERNEL_SOURCE := ./kernels/ext/n128/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1 -DFFT_PRELAYOUT_N128=1 -DFFT_EXT_LMUL2_COMBINE128=1
else ifeq ($(FFT_POINTS),256)
FFT_KERNEL_SOURCE := ./kernels/ext/n256/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1 -DFFT_PRELAYOUT_N256=1 -DFFT_EXT_LMUL2_RADIX4_N256=1
else ifeq ($(FFT_POINTS),512)
FFT_KERNEL_SOURCE := ./kernels/ext/n512/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1 -DFFT_EXT_LMUL2_COMBINE512=1 -DFFT_EXT_LMUL2_RADIX4_N256_SCALE1_N512=1
else ifeq ($(FFT_POINTS),1024)
FFT_KERNEL_SOURCE := ./kernels/ext/n1024/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1 -DFFT_EXT_LMUL2_RADIX4_N1024=1 -DFFT_EXT_LMUL2_RADIX4_N256_SHIFT1_N1024=1
else ifeq ($(FFT_POINTS),2048)
FFT_KERNEL_SOURCE := ./kernels/ext/n2048/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1 -DFFT_EXT_LMUL2_COMBINE2048=1 -DFFT_EXT_LMUL2_RADIX4_N1024_SCALE1=1 -DFFT_EXT_MULHRS_VNSRA_N2048_SCALE1=1 -DFFT_EXT_LMUL2_RADIX4_N256_SHIFT1_N2048=1
else ifeq ($(FFT_POINTS),4096)
FFT_KERNEL_SOURCE := ./kernels/ext/n4096/dft_ext.c
FFT_KERNEL_FLAGS := -DFFT_MAINLINE_EXT=1 -DFFT_EXT_LMUL2_RADIX4_N4096=1 -DFFT_EXT_LMUL2_RADIX4_N1024_SCALE1=1 -DFFT_EXT_MULHRS_VNSRA_N4096_SCALE1=1 -DFFT_EXT_LMUL2_RADIX4_N256_SHIFT1_N4096=1
endif
endif
