From 6c486c8e484466373685df744032766d40904023 Mon Sep 17 00:00:00 2001
From: XiangShanVU19p Port <phine-port@local>
Date: Wed, 14 Oct 2026 14:34:57 +0800
Subject: [PATCH 07/12] =?UTF-8?q?phine:=20drop=20JTAG=20frequency=20settin?=
 =?UTF-8?q?g=20entirely=20=E2=80=94=20default=20is=20a=20valid=20cable=20v?=
 =?UTF-8?q?alue?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Setting PARAM.FREQUENCY is optional tuning; the original hardcoded 12MHz
broke on Digilent adapters. Removing it eliminates the failure mode;
a commented example remains for anyone wanting to tune throughput.
---
 fpga_diff/vivado/scripts/jtag_write_ddr.tcl   | 15 ++-------------
 fpga_diff/vivado/scripts/jtag_write_flash.tcl | 14 ++------------
 fpga_diff/vivado/scripts/write_bitstream.tcl  | 16 +++-------------
 3 files changed, 7 insertions(+), 38 deletions(-)

diff --git a/fpga_diff/vivado/scripts/jtag_write_ddr.tcl b/fpga_diff/vivado/scripts/jtag_write_ddr.tcl
index 5abde9a..1c8bf96 100644
--- a/fpga_diff/vivado/scripts/jtag_write_ddr.tcl
+++ b/fpga_diff/vivado/scripts/jtag_write_ddr.tcl
@@ -25,19 +25,8 @@ if {[catch {open_hw_target} errmsg]} {
     puts "Opened hardware target"
 }
 
-# JTAG 频率: Digilent 等线缆仅支持离散频率列表, 硬编码 12MHz 会报 [Labtoolstcl 44-49]。
-# 依次试探常用合法值, 全部失败则沿用默认频率继续 (不影响功能, 仅影响写 DDR 吞吐)。
-set _jtag_freq_ok 0
-foreach _f {12000000 15000000 10000000 8000000 6000000 4000000 3000000 2000000 1000000} {
-    if {![catch {set_property PARAM.FREQUENCY $_f [current_hw_target]}]} {
-        puts "INFO: JTAG frequency = $_f Hz"
-        set _jtag_freq_ok 1
-        break
-    }
-}
-if {!$_jtag_freq_ok} {
-    puts "WARNING: 线缆不支持试探列表中的频率, 继续使用默认 [get_property PARAM.FREQUENCY [current_hw_target]] Hz"
-}
+# 不设置 JTAG 频率 (默认值即线缆合法工作值; 原 12MHz 硬编码在 Digilent 线上报 [Labtoolstcl 44-49])
+# set_property PARAM.FREQUENCY 15000000 [current_hw_target]
 
 # Get JTAG device handle
 set hw_device [lindex [get_hw_devices] 0]
diff --git a/fpga_diff/vivado/scripts/jtag_write_flash.tcl b/fpga_diff/vivado/scripts/jtag_write_flash.tcl
index 3018835..ab3bf3e 100644
--- a/fpga_diff/vivado/scripts/jtag_write_flash.tcl
+++ b/fpga_diff/vivado/scripts/jtag_write_flash.tcl
@@ -51,18 +51,8 @@ proc open_target {} {
     exit 1
   }
 
-  # JTAG 频率: 试探常用合法值 (Digilent 等线缆仅支持离散列表), 失败则用默认
-  set _jtag_freq_ok 0
-  foreach _f {12000000 15000000 10000000 8000000 6000000 4000000 3000000 2000000 1000000} {
-    if {![catch {set_property PARAM.FREQUENCY $_f [current_hw_target]}]} {
-      puts "INFO: JTAG frequency = $_f Hz"
-      set _jtag_freq_ok 1
-      break
-    }
-  }
-  if {!$_jtag_freq_ok} {
-    puts "WARNING: 线缆不支持试探列表中的频率, 继续使用默认 [get_property PARAM.FREQUENCY [current_hw_target]] Hz"
-  }
+  # 不设置 JTAG 频率 (默认值即线缆合法工作值)
+  # set_property PARAM.FREQUENCY 15000000 [current_hw_target]
 
   set hw_device [lindex [get_hw_devices] 0]
   if {$hw_device eq ""} {
diff --git a/fpga_diff/vivado/scripts/write_bitstream.tcl b/fpga_diff/vivado/scripts/write_bitstream.tcl
index 61115b7..88efd49 100644
--- a/fpga_diff/vivado/scripts/write_bitstream.tcl
+++ b/fpga_diff/vivado/scripts/write_bitstream.tcl
@@ -26,19 +26,9 @@ open_hw_manager
 connect_hw_server
 open_hw_target
 
-# JTAG 频率: Digilent 等线缆仅支持离散频率列表, 硬编码 12MHz 会报 [Labtoolstcl 44-49]。
-# 依次试探常用合法值, 全部失败则沿用默认频率继续 (不影响功能, 仅影响 JTAG-to-AXI 吞吐)。
-set _jtag_freq_ok 0
-foreach _f {12000000 15000000 10000000 8000000 6000000 4000000 3000000 2000000 1000000} {
-    if {![catch {set_property PARAM.FREQUENCY $_f [current_hw_target]}]} {
-        puts "INFO: JTAG frequency = $_f Hz"
-        set _jtag_freq_ok 1
-        break
-    }
-}
-if {!$_jtag_freq_ok} {
-    puts "WARNING: 线缆不支持试探列表中的频率, 继续使用默认 [get_property PARAM.FREQUENCY [current_hw_target]] Hz"
-}
+# 不设置 JTAG 频率: 打开 target 后的默认频率即线缆合法工作值。
+# (原来固定 12MHz 会在 Digilent 线缆上报 [Labtoolstcl 44-49]; 如需调高吞吐可手动解除注释)
+# set_property PARAM.FREQUENCY 15000000 [current_hw_target]
 
 current_hw_device [get_hw_devices *]
 refresh_hw_device [current_hw_device]
-- 
2.43.0

