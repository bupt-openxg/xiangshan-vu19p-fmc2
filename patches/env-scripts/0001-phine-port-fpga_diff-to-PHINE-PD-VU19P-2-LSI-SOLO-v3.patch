 .../vivado/tcl/common/pcie_axi_axis_bd.tcl    |   2 +-
 fpga_diff/vivado/tcl/common/vio_0.tcl         |   2 +-
 fpga_diff/vivado/tcl/common/xs_uart.tcl       |  20 +-
 14 files changed, 231 insertions(+), 594 deletions(-)

diff --git a/fpga_diff/src/rtl/common/fpga_top_debug.sv b/fpga_diff/src/rtl/common/fpga_top_debug.sv
index fc4509f..ffa3548 100755
--- a/fpga_diff/src/rtl/common/fpga_top_debug.sv
+++ b/fpga_diff/src/rtl/common/fpga_top_debug.sv
@@ -97,15 +97,7 @@ module fpga_top_debug
    input                 JTAG_TMS,         // come from gpio
    input                 JTAG_TDI,         // come from gpio
    output                JTAG_TDO,         // come from gpio
-   input                 JTAG_TRSTn,       // come from gpio
-
-   output                SD_CLK,
-   inout                 SD_CMD,
-   inout                 SD_DATA0,
-   inout                 SD_DATA1,
-   inout                 SD_DATA2,
-   inout                 SD_DATA3,
-   input                 SD_DECT
+   input                 JTAG_TRSTn        // come from gpio
 );
 
 wire vio_sw6;
@@ -295,24 +287,11 @@ wire DDR0_ZQ = 'h0;
 //assign qspi_mi1 = QSPI_DAT_1;
 //assign qspi_mi0 = QSPI_DAT_0;
 
-// sd-io
-assign SD_CLK = sdmmc_cclk_card;
-
-assign sdmmc_sd_cmd_in = SD_CMD;
-assign SD_CMD = sdmmc_sd_cmd_out_en ? sdmmc_sd_cmd_out : 1'bz; 
-
-assign sdmmc_sd_dat_in[0] = SD_DATA0;
-assign sdmmc_sd_dat_in[1] = SD_DATA1;
-assign sdmmc_sd_dat_in[2] = SD_DATA2;
-assign sdmmc_sd_dat_in[3] = SD_DATA3;
-
-assign SD_DATA0 = sdmmc_sd_dat_out_en[0] ? sdmmc_sd_dat_out[0] : 1'bz;
-assign SD_DATA1 = sdmmc_sd_dat_out_en[1] ? sdmmc_sd_dat_out[1] : 1'bz;
-assign SD_DATA2 = sdmmc_sd_dat_out_en[2] ? sdmmc_sd_dat_out[2] : 1'bz;
-assign SD_DATA3 = sdmmc_sd_dat_out_en[3] ? sdmmc_sd_dat_out[3] : 1'bz;
-
-assign sdmmc_card_detect_n = SD_DECT;
-assign sdmmc_card_write_prot = 0;
+// sd-io: PHINE 板无 SD 槽 -> 置为"无卡"状态, sdmmc_* 输出留空由综合优化
+assign sdmmc_sd_cmd_in = 1'b1;
+assign sdmmc_sd_dat_in = 4'hf;
+assign sdmmc_card_detect_n = 1'b1;
+assign sdmmc_card_write_prot = 1'b0;
 
 // gmac wiring
 `ifdef XS_GMAC
