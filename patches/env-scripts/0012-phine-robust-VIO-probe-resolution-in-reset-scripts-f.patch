index 57957c1..38ae28e 100644
--- a/fpga_diff/vivado/scripts/reset_ddr.tcl
+++ b/fpga_diff/vivado/scripts/reset_ddr.tcl
@@ -1,3 +1,5 @@
+# DDR 复位脉冲: VIO sw4 0->1  (纯 TCL/VIO 控制, 不使用板卡按键)
+# 用法: vivado -mode tcl -source reset_ddr.tcl -tclargs <fpga_top_debug.ltx>
 puts "probe .ltx path:"
 puts [lindex $argv 0]
 set file_name [lindex $argv 0]
@@ -7,6 +9,24 @@ if {![file exists $file_name]} {
     exit 1
 }
 
+# ---- 探针解析助手 ----------------------------------------------------------
+# 按精确名解析出"输出探针"对象; 解析一次后全程复用同一对象。
+# 必须在 set_property/commit 之前解析完毕: Vivado 在探针被修改后再用模式
+# 查询会回退返回该 VIO 的全部探针(含 <const0> 常量探针), 导致
+# commit_hw_vio 报 [Labtoolstcl 44-152] 错误。
+proc vio_probe_out {vio name} {
+    foreach p [get_hw_probes -of_objects $vio] {
+        if {[get_property NAME $p] eq $name && ![catch {get_property OUTPUT_VALUE $p}]} {
+            return $p
+        }
+    }
+    foreach p [get_hw_probes -of_objects $vio] {
+        if {[get_property NAME $p] eq $name} { return $p }
+    }
+    return ""
+}
+# ---------------------------------------------------------------------------
+
 open_hw_manager
 connect_hw_server
 open_hw_target
@@ -16,17 +36,22 @@ current_hw_device [get_hw_devices *]
 # load .ltx file
 set_property PROBES.FILE $file_name [current_hw_device]
 
-refresh_hw_device [current_hw_device]
+refresh_hw_device -update_hw_probes true [current_hw_device]
 refresh_hw_vio hw_vio_1
 
-puts [get_hw_probes -of_objects [get_hw_vios hw_vio_1]]
-# vio_sw4 0
-set_property OUTPUT_VALUE 0 [get_hw_probes vio_sw4 -of_objects [get_hw_vios hw_vio_1]]
-commit_hw_vio [get_hw_probes {vio_sw4} -of_objects [get_hw_vios hw_vio_1]]
-puts [get_property OUTPUT_VALUE [get_hw_probes -of_objects [get_hw_vios hw_vio_1]]]
-after 500
-# vio_sw4 1
-set_property OUTPUT_VALUE 1 [get_hw_probes vio_sw4 -of_objects [get_hw_vios hw_vio_1]]
-commit_hw_vio [get_hw_probes {vio_sw4} -of_objects [get_hw_vios hw_vio_1]]
-puts [get_property OUTPUT_VALUE [get_hw_probes -of_objects [get_hw_vios hw_vio_1]]]
+set vio [get_hw_vios hw_vio_1]
+puts "probes: [get_hw_probes -of_objects $vio]"
+
+# sw4 输出探针名解析 (v2: vio_sw4, v3 中被内联: ddr_rstn_to_core)
+set sw4 [vio_probe_out $vio vio_sw4]
+if {$sw4 eq ""} { set sw4 [vio_probe_out $vio ddr_rstn_to_core] }
+if {$sw4 eq ""} { puts "ERROR: 未找到 sw4 输出探针"; exit 1 }
+puts "sw4 probe: $sw4"
+
+set_property OUTPUT_VALUE 0 $sw4
+commit_hw_vio $sw4
+after 300
+set_property OUTPUT_VALUE 1 $sw4
+commit_hw_vio $sw4
+puts "reset_ddr 完成 (sw4: 0 -> 1)"
 exit
